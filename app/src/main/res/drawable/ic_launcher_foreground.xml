<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Telemetry Gauge Arc (Cool to Hot Gradient) -->
    <path
        android:pathData="M32,68 A28,28 0 1,1 76,68"
        android:strokeWidth="3.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="68"
                android:endX="82"
                android:endY="68"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.4" android:color="#22C55E" />
                <item android:offset="0.7" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#EF4444" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Gauge tick markers (Cool side, Mid, Warning side) -->
    <path
        android:pathData="M27,50 L31,50 M35,31 L38,34 M54,23 L54,27 M70,34 L73,31 M77,50 L81,50"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeColor="#64748B" />

    <!-- Stylized CVT Pulley / Belt Cones subtle silhouette in background -->
    <path
        android:pathData="M37,42 A8,8 0 1,0 37,58 A8,8 0 1,0 37,42 Z M71,42 A8,8 0 1,0 71,58 A8,8 0 1,0 71,42 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#334155" />
    <path
        android:pathData="M37,42 L71,44 M37,58 L71,56"
        android:strokeWidth="1.2"
        android:strokeColor="#334155" />

    <!-- Thermometer Outer Housing (White/Chrome Stem and Bulb) -->
    <path
        android:pathData="M51,32 C51,30.34 52.34,29 54,29 C55.66,29 57,30.34 57,32 L57,56.2 C59.4,57.5 61,60.1 61,63 C61,66.87 57.87,70 54,70 C50.13,70 47,66.87 47,63 C47,60.1 48.6,57.5 51,56.2 Z"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:strokeColor="#FFFFFF"
        android:fillColor="#1E293B" />

    <!-- Thermometer Graduations / Measurement Ticks -->
    <path
        android:pathData="M59,36 L63,36 M59,42 L62,42 M59,48 L63,48 M59,54 L62,54"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeColor="#38BDF8" />

    <!-- Thermometer Mercury Fluid Column & Bulb (Hot Red/Amber Core) -->
    <path android:pathData="M54,58 A6,6 0 1,0 54,68 A6,6 0 1,0 54,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="63"
                android:gradientRadius="6"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF5252" />
                <item android:offset="0.7" android:color="#EF4444" />
                <item android:offset="1.0" android:color="#DC2626" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Fluid Column inside Stem (Active temperature level) -->
    <path
        android:pathData="M52.8,38 L55.2,38 L55.2,59 L52.8,59 Z"
        android:fillColor="#EF4444" />

    <!-- Glowing Bulb Highlight Reflection -->
    <path
        android:pathData="M52,61 A2.2,2.2 0 0,1 55,60"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFA4A4" />

    <!-- "CVT" Modern High-Tech Typography Badge at Bottom -->
    <!-- Letter C -->
    <path
        android:pathData="M40,78.5 L36,78.5 C34.3,78.5 33,79.8 33,81.5 L33,84.5 C33,86.2 34.3,87.5 36,87.5 L40,87.5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#38BDF8" />

    <!-- Letter V -->
    <path
        android:pathData="M48,78.5 L53.5,87.5 L59,78.5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#38BDF8" />

    <!-- Letter T -->
    <path
        android:pathData="M66,78.5 L74,78.5 M70,78.5 L70,87.5"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeColor="#38BDF8" />

</vector>